      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [iq_test_mode,iq_test_ref,v_ref_cmd_mmps,x_ref_mm,load_force,vdc,pos_loop_en,id_ref_set,x_override_enable,x_override_mm] = fcn(t, init_done, close_loop_en, MIL_Mode, MIL_Ts_s, MIL_SpeedCommand_mmps, MIL_PositiveSpeedDuration_s, MIL_ZeroSpeedDuration_s, MIL_NegativeSpeedDuration_s, MIL_IqInjection_A, MIL_IqInjectionDelay_s, MIL_IqRefRampTime_s, MIL_IqPositiveDuration_s, MIL_IqZeroDuration_s, MIL_IqNegativeDuration_s, MIL_IqCycleCount, MIL_PositionStep_mm, MIL_PositionStepDelay_s, MIL_LoadForce_N, MIL_Vdc_V, MIL_LoadStartRel_s, MIL_LoadEndRel_s)
%#codegen
persistent test_timer_s
if isempty(test_timer_s)
    test_timer_s = 0;
end
iq_test_mode = 0;
iq_test_ref = 0;
v_ref_cmd_mmps = 0;
x_ref_mm = 0;
load_force = 0;
vdc = MIL_Vdc_V;
pos_loop_en = 0;
id_ref_set = 0;
x_override_enable = 0;
x_override_mm = 0;
if (MIL_Mode == 1 &amp;&amp; init_done ~= 0) || (MIL_Mode == 4 &amp;&amp; init_done ~= 0 &amp;&amp; close_loop_en ~= 0) || (MIL_Mode ~= 1 &amp;&amp; MIL_Mode ~= 4 &amp;&amp; init_done ~= 0 &amp;&amp; close_loop_en ~= 0)
    test_timer_s = test_timer_s + MIL_Ts_s;
else
    test_timer_s = 0;
end
if init_done ~= 0 &amp;&amp; close_loop_en ~= 0 &amp;&amp; ...
        test_timer_s &gt;= MIL_LoadStartRel_s &amp;&amp; ...
        test_timer_s &lt; MIL_LoadEndRel_s
    load_force = MIL_LoadForce_N;
end
switch MIL_Mode
    case {1, 4}
        if init_done == 0
            return;
        end
        cycle_period_s = MIL_IqPositiveDuration_s + MIL_IqZeroDuration_s + MIL_IqNegativeDuration_s + MIL_IqZeroDuration_s;
        cycle_time_s = test_timer_s - MIL_IqInjectionDelay_s;
        if cycle_time_s &lt; 0 || cycle_period_s &lt;= 0
            return;
        end
        cycle_index = floor(cycle_time_s / cycle_period_s);
        phase_s = cycle_time_s - cycle_index * cycle_period_s;
        if cycle_index &gt;= MIL_IqCycleCount
            return;
        end
        iq_test_mode = 1;
        ramp_s = MIL_IqRefRampTime_s;
        pos_ramp_s = min(ramp_s, 0.5*MIL_IqPositiveDuration_s);
        neg_ramp_s = min(ramp_s, 0.5*MIL_IqNegativeDuration_s);
        pos_end_s = MIL_IqPositiveDuration_s;
        neg_start_s = MIL_IqPositiveDuration_s + MIL_IqZeroDuration_s;
        neg_end_s = neg_start_s + MIL_IqNegativeDuration_s;
        if phase_s &lt; pos_end_s
            if pos_ramp_s &gt; 0 &amp;&amp; phase_s &lt; pos_ramp_s
                iq_test_ref = MIL_IqInjection_A * phase_s / pos_ramp_s;
            elseif pos_ramp_s &gt; 0 &amp;&amp; phase_s &gt; pos_end_s - pos_ramp_s
                iq_test_ref = MIL_IqInjection_A * (pos_end_s - phase_s) / pos_ramp_s;
            else
                iq_test_ref = MIL_IqInjection_A;
            end
        elseif phase_s &gt;= neg_start_s &amp;&amp; phase_s &lt; neg_end_s
            if neg_ramp_s &gt; 0 &amp;&amp; phase_s &lt; neg_start_s + neg_ramp_s
                iq_test_ref = -MIL_IqInjection_A * (phase_s - neg_start_s) / neg_ramp_s;
            elseif neg_ramp_s &gt; 0 &amp;&amp; phase_s &gt; neg_end_s - neg_ramp_s
                iq_test_ref = -MIL_IqInjection_A * (neg_end_s - phase_s) / neg_ramp_s;
            else
                iq_test_ref = -MIL_IqInjection_A;
            end
        end
    case 2
        if init_done == 0 || close_loop_en == 0
            return;
        end
        t1 = MIL_PositiveSpeedDuration_s;
        t2 = MIL_PositiveSpeedDuration_s + MIL_ZeroSpeedDuration_s;
        t3 = MIL_PositiveSpeedDuration_s + MIL_ZeroSpeedDuration_s + MIL_NegativeSpeedDuration_s;
        if test_timer_s &lt; t1
            v_ref_cmd_mmps = MIL_SpeedCommand_mmps;
        elseif test_timer_s &lt; t2
            v_ref_cmd_mmps = 0;
        elseif test_timer_s &lt; t3
            v_ref_cmd_mmps = -MIL_SpeedCommand_mmps;
        else
            v_ref_cmd_mmps = 0;
        end
    case 3
        if init_done == 0 || close_loop_en == 0
            return;
        end
        pos_loop_en = 1;
        if test_timer_s &gt;= MIL_PositionStepDelay_s
            x_ref_mm = MIL_PositionStep_mm;
        end
end</P>
      </eml>
