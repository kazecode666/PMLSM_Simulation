        <P Name="isEML">1</P>
        <P Name="script">function [enable_cmd,fault_i,fault_u,close_loop_en,init_start,init_reset,pi_reset_en,pwm_enable] = fcn(t, init_done, MIL_Mode, MIL_Ts_s, MIL_EnableTime_s, MIL_InitDoneDelay_s, MIL_Fault_Test_Case, MIL_Fault_Start_s)
%#codegen
persistent init_done_timer_s
if isempty(init_done_timer_s)
    init_done_timer_s = 0;
end
enable_cmd = 0;
fault_i = 0;
fault_u = 0;
close_loop_en = 0;
init_start = 0;
init_reset = 1;
pi_reset_en = 1;
pwm_enable = 0;
if t &gt;= MIL_EnableTime_s
    enable_cmd = 1;
    init_start = 1;
    init_reset = 0;
    pi_reset_en = 0;
end
if MIL_Fault_Test_Case == 1 &amp;&amp; t &gt;= MIL_Fault_Start_s
    fault_i = 1;
elseif MIL_Fault_Test_Case == 2 &amp;&amp; t &gt;= MIL_Fault_Start_s
    fault_u = 1;
elseif MIL_Fault_Test_Case == 3 &amp;&amp; t &gt;= MIL_Fault_Start_s
    enable_cmd = 0;
end
if enable_cmd ~= 0 &amp;&amp; init_done ~= 0 &amp;&amp; fault_i == 0 &amp;&amp; fault_u == 0
    init_done_timer_s = init_done_timer_s + MIL_Ts_s;
else
    init_done_timer_s = 0;
end
if enable_cmd ~= 0 &amp;&amp; MIL_Mode ~= 1 &amp;&amp; init_done_timer_s &gt;= MIL_InitDoneDelay_s
    close_loop_en = 1;
end
if enable_cmd ~= 0 &amp;&amp; fault_i == 0 &amp;&amp; fault_u == 0
    pwm_enable = 1;
else
    pwm_enable = 0;
end
end</P>
