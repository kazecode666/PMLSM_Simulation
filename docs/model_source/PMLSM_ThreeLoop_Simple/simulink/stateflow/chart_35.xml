    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">35</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [x_ref_mm,vdc,load_N,Close_Loop_EN,Position_Loop_EN,PWM_EN,v_ref_cmd,id_ref_cmd,iq_test_mode,iq_test_ref,PI_Reset_EN] = Simple_Host(t, Host_Enable_Schedule, Host_Speed_mmps, Host_Id_A, Host_Iq_Test_Mode, Host_Iq_A, Host_PI_Reset_EN, Host_Start_s, Host_Target_mm, Udc, Host_Load_N, Host_Traj_Vmax, Host_Traj_Amax, Host_Traj_Jmax, Host_Speed_Ramp_s)
% Smooth acceleration - constant speed - smooth deceleration.
x_ref_mm=pmlsm_scurve_profile(t-Host_Start_s,Host_Target_mm,Host_Traj_Vmax,Host_Traj_Amax,Host_Traj_Jmax,Host_Speed_Ramp_s);
r=min(max((t-Host_Start_s)/max(Host_Speed_Ramp_s,1e-6),0),1);
v_ref_cmd=Host_Speed_mmps*(10*r^3-15*r^4+6*r^5);
vdc=Udc; load_N=Host_Load_N;
Close_Loop_EN=0; Position_Loop_EN=0; PWM_EN=0;
for k=1:size(Host_Enable_Schedule,1)
 if t&gt;=Host_Enable_Schedule(k,1)
  Close_Loop_EN=double(Host_Enable_Schedule(k,2)~=0);
  Position_Loop_EN=double(Host_Enable_Schedule(k,3)~=0);
  PWM_EN=double(Host_Enable_Schedule(k,4)~=0);
 end
end
id_ref_cmd=Host_Id_A;
iq_test_mode=Host_Iq_Test_Mode; iq_test_ref=Host_Iq_A;
PI_Reset_EN=Host_PI_Reset_EN;
end</P>
      </eml>
    </state>
