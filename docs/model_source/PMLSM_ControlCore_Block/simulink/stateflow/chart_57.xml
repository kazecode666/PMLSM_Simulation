        <P Name="script">function [v_ref_safe, travel_fault_latch] = Travel_Safety_Manager( ...
    x_mm, v_ref, X_max_soft, X_min_soft, X_max_hard, X_min_hard, travel_fault_latch_z)
% PMLSM travel safety manager
% 功能：
% 1. 软限位：只限制继续向越界方向运动，不触发硬关断
% 2. 硬限位：触发 travel_fault_latch，锁存故障
% 3. travel_fault_latch = 1 后，v_ref_safe 强制为 0
% 注意：
% 当前版本没有 fault_reset 输入，硬限位故障一旦触发，
% 只能通过 DSP 复位/重新运行程序清除。
% 速度方向判断死区，单位 mm/s
V_eps = 1.0;

% ---------- 1. 硬限位检测 ----------
hard_hi = (x_mm &gt;= X_max_hard);
hard_lo = (x_mm &lt;= X_min_hard);
hard_fault_raw = hard_hi || hard_lo;

% ---------- 2. 外部锁存 ----------
% 上一拍已经故障，或者当前触发硬限位，则继续保持故障
fault_latch_now = (travel_fault_latch_z &gt; 0.5) || hard_fault_raw;

% ---------- 3. 软限位方向性限制 ----------
right_soft = (x_mm &gt;= X_max_soft);
left_soft  = (x_mm &lt;= X_min_soft);

v_pos_dir = (v_ref &gt;  V_eps);
v_neg_dir = (v_ref &lt; -V_eps);

right_block = right_soft &amp;&amp; v_pos_dir;
left_block  = left_soft  &amp;&amp; v_neg_dir;

soft_block = right_block || left_block;

% ---------- 4. 输出安全速度 ----------
if fault_latch_now
    v_ref_safe = 0.0;
elseif soft_block
    v_ref_safe = 0.0;
else
    v_ref_safe = v_ref;
end

travel_fault_latch = double(fault_latch_now);
end</P>
